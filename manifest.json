{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "1.0.0",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hattrick.org/*"
      ],
      "css": [
        "css/01-palette.css",
        "css/02-base.css",
        "css/03-components.css",
        "css/04-pages.css",
        "css/05-foxtrick.css",
        "css/06-dhth.css",
        "css/07-skillvalue.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
